# Bearer token agents must send: Authorization: Bearer <BSL_MCP_TOKEN>
BSL_MCP_TOKEN=change-me

# Host port for nginx (agents connect to http://<host>:<port>/bsl/<proj>/mcp)
NGINX_PORT=8080

# Absolute host paths of each 1C project (mounted 1:1 into the container).
# The service name must be bsl-<proj> for the URL /bsl/<proj>/... to route.
PROJ_A_PATH=/srv/1c/proj-a
PROJ_B_PATH=/srv/1c/proj-b
PROJ_C_PATH=/srv/1c/proj-c
